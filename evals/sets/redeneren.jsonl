{"id": "r01", "prompt": "Een trein vertrekt om 14:10 en rijdt 2 uur en 35 minuten. Hoe laat komt hij aan? Antwoord als HH:MM.", "checks": [{"type": "contains", "all": ["16:45"]}], "difficulty": 1}
{"id": "r02", "prompt": "Ik heb 3 dozen met elk 12 eieren. Ik breek er 7. Hoeveel heelblijvende eieren heb ik? Geef alleen het getal als laatste.", "checks": [{"type": "number", "value": 29, "tolerance": 0}], "difficulty": 1, "counterfactual": [{"prompt": "Ik heb 4 dozen met elk 12 eieren. Ik breek er 7. Hoeveel heelblijvende eieren heb ik? Geef alleen het getal als laatste.", "checks": [{"type": "number", "value": 41, "tolerance": 0}]}]}
{"id": "r03", "prompt": "Wat is 17 × 23? Eindig met het getal.", "checks": [{"type": "number", "value": 391, "tolerance": 0}], "difficulty": 1, "counterfactual": [{"prompt": "Wat is 17 × 24? Eindig met het getal.", "checks": [{"type": "number", "value": 408, "tolerance": 0}]}]}
{"id": "r04", "prompt": "Alle katten zijn dieren. Sommige dieren zijn zwart. Volgt hieruit dat sommige katten zwart zijn? Antwoord ja of nee en leg kort uit.", "checks": [{"type": "regex", "pattern": "(?i)\\bnee\\b"}], "difficulty": 2}
{"id": "r05", "prompt": "Een product kost €80. Er gaat 25% korting af en daarna komt er 21% btw bij. Wat is de eindprijs in euro? Eindig met het bedrag.", "checks": [{"type": "number", "value": 72.6, "tolerance": 0.01}], "difficulty": 2, "counterfactual": [{"prompt": "Een product kost €80. Er gaat 50% korting af en daarna komt er 21% btw bij. Wat is de eindprijs in euro? Eindig met het bedrag.", "checks": [{"type": "number", "value": 48.4, "tolerance": 0.01}]}]}
{"id": "r06", "prompt": "Anna is ouder dan Bas. Bas is ouder dan Cees. Wie is de jongste?", "checks": [{"type": "contains", "all": ["cees"]}], "difficulty": 1}
{"id": "r07", "prompt": "Hoeveel seconden zitten er in een dag? Eindig met het getal.", "checks": [{"type": "number", "value": 86400, "tolerance": 0}], "difficulty": 1}
{"id": "r08", "prompt": "Een vierkant heeft een oppervlakte van 49 cm². Wat is de omtrek in cm? Eindig met het getal.", "checks": [{"type": "number", "value": 28, "tolerance": 0}], "difficulty": 2, "counterfactual": [{"prompt": "Een vierkant heeft een oppervlakte van 64 cm². Wat is de omtrek in cm? Eindig met het getal.", "checks": [{"type": "number", "value": 32, "tolerance": 0}]}]}
{"id": "r09", "prompt": "Als je een munt drie keer opgooit, wat is de kans op precies twee keer kop? Geef het als decimaal getal.", "checks": [{"type": "number", "value": 0.375, "tolerance": 0.001}], "difficulty": 3}
